{
  "permissionMode": "acceptEdits",
  "allowedTools": [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep",
    "Bash(mvn test *)",
    "Bash(mvn clean compile *)",
    "Bash(mvn validate -N)",
    "Bash(git status)",
    "Bash(git diff *)",
    "Bash(git add *)",
    "Bash(git commit *)"
  ],
  "deniedPaths": [
    ".env*",
    "**/secrets/**",
    ".github/workflows/**",
    ".gitlab-ci.yml",
    "CODEOWNERS"
  ],
  "maxTurns": 60,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/AGENTS.md\" ]; then cat \"$CLAUDE_PROJECT_DIR/AGENTS.md\"; fi"
          }
        ]
      }
    ]
  }
}
